{
  "server": {
    "host": "0.0.0.0",
    "port": 1933,
    "root_api_key": "${OPENVIKING_ROOT_API_KEY}"
  },
  "storage": {
    "workspace": "/app/.openviking/workspace"
  },
  "embedding": {
    "dense": {
      "provider": "ollama",
      "api_base": "http://host.docker.internal:11434/v1",
      "model": "nomic-embed-text",
      "dimension": 768
    }
  },
  "vlm": {
    "provider": "ollama",
    "model": "gemma4:12b-it-q8_0",
    "api_base": "http://host.docker.internal:11434",
    "api_key": "ollama",
    "max_tokens": 8192,
    "temperature": 0.1
  }
}
