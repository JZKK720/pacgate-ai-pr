{
  // Deployment contract major this directory conforms to.
  //
  // STILL 1. Upstream did NOT bump it when it rebuilt the topology (5 services -> 2), which
  // is why `qm check` fails on service NAMES rather than on a contract mismatch. Do not
  // read contract:1 as "unchanged architecture".
  "contract": 1,

  "orgId": "pacgate",

  // PORTAL IS GONE. In 0.1.18 the public sign-in front door AND the browser web UI are both
  // served by `core` (operator settings at /settings). So this points at core.
  //
  // 8182 = basePort + 2. That is not a free choice: 0.1.18 requires publicUrl to use
  // exactly basePort+2 ("where qm up publishes core's front door"), and it says so with a
  // hard error if you get it wrong. The old 8181 pointed at the departed portal.
  "publicUrl": "http://localhost:8182",

  // Keep qm in the 8180s: Pacgate's own stack owns 8089 and 1933.
  "basePort": 8180,

  "target": "docker",

  // Unchanged in spirit: an OpenAI-compatible endpoint served by Ollama on the host.
  // MODEL_BASE_URL is renamed OPENAI_BASE_URL in the core env below.
  "modelProvider": "openai",

  // 5 services -> 2. "core" now also serves web-ui and the settings page; "auth" stays as
  // the in-core sign-in broker. "portal", "web-ui" and "admin" no longer exist as services.
  // "egress-proxy" is available but not enabled: it enforces sandbox egress policy through a
  // TLS proxy, which is a deployment decision rather than a default.
  "services": ["core", "auth"],

  "plugins": [],

  "skills": [],

  // HARNESS is dropped: the harness selection was removed and the agent runtime is inside
  // core. SANDBOX_BACKEND=local is retained.
  //
  // MODEL_BASE_URL -> OPENAI_BASE_URL (provider-endpoints.ts: PROVIDER_BASE_URL_ENV.openai).
  //
  // QM_CORE_CONTAINER is what replaces our local-sandbox.ts source patch. Upstream reads it
  // in localSandboxEnv (sandbox-settings.ts:91) and then reaches the sandbox by CONTAINER
  // DNS NAME and attaches core to the sandbox network (local-sandbox.ts:168/237), instead of
  // dialling 127.0.0.1:<published port> which inside a container is core itself. This is
  // upstream issue #271 / fix PR #1675, and 0.1.4 has ZERO references to the variable -
  // which is why the patch existed.
  //
  // PRIVATE_NETWORK_ALLOWED_ORIGINS is REQUIRED for the Ollama lane to work at all.
  // 0.1.18 refuses a custom provider whose baseUrl resolves to a private address - a
  // deliberate SSRF control - and logs:
  //   "custom provider ollama: host.docker.internal resolves to a private network address;
  //    a deployment operator can allow this exact origin with PRIVATE_NETWORK_ALLOWED_ORIGINS"
  // Without it every turn fails with a bare "Connection error." Verified both ways on a
  // scratch deployment: absent -> Connection error; present -> a real assistant reply.
  //
  // AUTH_EMAIL_TRANSPORT is retained because 0.1.18 REJECTS a config without it
  // ("must be resend or smtp") even though sign-in email is disabled by default. Its SMTP
  // partners are now OPTIONAL secrets, so the Mailpit catcher and the SMTP wiring are gone
  // while this one vestigial key stays.
  "env": {
    "core": {
      "SANDBOX_BACKEND": "local",
      "OPENAI_BASE_URL": "http://host.docker.internal:11434/v1",
      "PRIVATE_NETWORK_ALLOWED_ORIGINS": "http://host.docker.internal:11434",
      "QM_CORE_CONTAINER": "qm-pacgate-core",
      "PI_MODEL": "minimax-m3.1-flash:cloud",
      "PI_DETECT_MODEL": "minimax-m3.1-flash:cloud",
      "PI_TITLE_MODEL": "minimax-m3.1-flash:cloud",
      "PI_JUDGE_MODEL": "minimax-m3.1-flash:cloud",
      "NODE_ENV": "development"
    },
    "auth": { "AUTH_EMAIL_TRANSPORT": "smtp", "AUTH_BRAND_NAME": "PacGate", "NODE_ENV": "development" }
  },

  // The "sandbox" block is DELETED. `sandbox.image` is retired and ignored from 0.1.10 (a
  // warning only from 0.1.10-0.1.15, which is the false green recorded in
  // UPSTREAM-0.1.19-VERDICT.md 9.1), and `qm sandbox publish` no longer exists.
  //
  // Sandboxes now boot the platform's stock sandbox-base image and our layer is a BIND
  // MOUNT (the `sandbox/` directory). That retires
  // deploy/DEFECT-qm-sandbox-image-unobtainable.md: the entire GHCR-visibility workaround
  // existed only to keep a published sandbox image resolvable.
  //
  // The two URLs the sandbox tools use (PACGATE_API_URL=http://host.docker.internal:8089/pacgate,
  // OPENVIKING_URL=http://host.docker.internal:1933) are no longer expressible here; they
  // belong to the layer env and are carried in deploy/qm-pacgate/migration-0.1.18/.

  "secretEnv": { "core": { "ADMIN_GRANTS": "ADMIN_GRANTS" } }
}
